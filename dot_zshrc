# Homebrew (sets HOMEBREW_PREFIX and PATH)
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# History: each tab keeps its own until it closes, but every command is saved right away
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt INC_APPEND_HISTORY NO_SHARE_HISTORY EXTENDED_HISTORY
setopt HIST_IGNORE_DUPS HIST_FIND_NO_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# Completion (case-insensitive, arrow-key menu)
fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select

# Editor (used by git commit and others)
export EDITOR=nvim VISUAL=nvim

# Colours for ls and grep (macOS uses CLICOLOR; Linux ls needs --color)
export CLICOLOR=1
[[ "$OSTYPE" == linux* ]] && alias ls='ls --color=auto'
alias grep='grep --color=auto'

# Tools
# fzf colours: Catppuccin Mocha (https://github.com/catppuccin/fzf)
export FZF_DEFAULT_OPTS="
  --color=fg:#cdd6f4,bg:#1e1e2e,hl:#f38ba8
  --color=fg+:#cdd6f4,bg+:#313244,hl+:#f38ba8
  --color=border:#313244,header:#f38ba8,gutter:#1e1e2e
  --color=spinner:#f5e0dc,info:#cba6f7
  --color=pointer:#f5e0dc,marker:#b4befe,prompt:#cba6f7"
eval "$(fzf --zsh)"
eval "$(zoxide init zsh)"
eval "$(starship init zsh)"
eval "$(mise activate zsh)"

source ~/.config/zsh/aliases.zsh

# Plugins
source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# Machine-specific settings that don't belong in the repo
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

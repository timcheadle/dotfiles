{{- /* Asked once per machine; answers are saved locally, never in this repo. */ -}}
{{- $name := promptStringOnce . "name" "Your full name" -}}
{{- $email := promptStringOnce . "email" "Your email for git on this Mac" -}}

# Plain files become symlinks into the repo, so edits in ~ are edits here.
mode = "symlink"

[data]
  name = {{ $name | quote }}
  email = {{ $email | quote }}

[user]
	name = {{ .name }}
	email = {{ .personalEmail }}

# GitLab remotes (ssh or https) use the work email.
[includeIf "hasconfig:remote.*.url:*gitlab*/**"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://*gitlab*/**"]
	path = ~/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://*gitlab*/**"]
	path = ~/.config/git/work.gitconfig

[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true  # n/N jump between files
	# Green/red text on light line backgrounds that sit well on Rosé Pine Moon
	syntax-theme = ansi
	plus-style = "#a6da95" "#263838"
	plus-emph-style = "#a6da95" bold "#34574a"
	minus-style = "#eb6f92" "#382536"
	minus-emph-style = "#eb6f92" bold "#5a2f47"

[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	autoStash = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[branch]
	sort = -committerdate

{{ if eq .chezmoi.os "darwin" -}}
# Sign commits with the 1Password SSH key (public half below)
[user]
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAroxrryEQ6hxohtRusZ7NR3chBA+kHx59HpeFKZRS1n
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
{{- end }}

# Machine-specific settings that don't belong in this repo.
[include]
	path = ~/.gitconfig.local

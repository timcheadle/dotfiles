[user]
	name = {{ .name }}
	email = {{ .email }}

[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true  # n/N jump between files
	# Catppuccin Mocha green/red text on tinted line backgrounds
	syntax-theme = ansi
	plus-style = "#a6e3a1" "#323c3f"
	plus-emph-style = "#a6e3a1" bold "#44554e"
	minus-style = "#f38ba8" "#3e2e40"
	minus-emph-style = "#f38ba8" bold "#5a3d50"

[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	autoStash = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[branch]
	sort = -committerdate

# Machine-specific settings that don't belong in this repo.
[include]
	path = ~/.gitconfig.local

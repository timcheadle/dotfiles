{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# macOS settings. chezmoi re-runs this whenever the file changes.
# No admin needed. Some settings take effect after logging out and back in.
# What each one does: docs/macos.md
set -euo pipefail

# --- Keyboard
defaults write NSGlobalDomain KeyRepeat -int 2                       # fastest repeat
defaults write NSGlobalDomain InitialKeyRepeat -int 15               # short delay before repeat
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false   # holding a key repeats it
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false
defaults write NSGlobalDomain AppleKeyboardUIMode -int 2             # Tab moves between all controls

# --- Trackpad (built-in and Magic Trackpad) and mouse
for domain in com.apple.AppleMultitouchTrackpad com.apple.driver.AppleBluetoothMultitouch.trackpad; do
  defaults write "$domain" Clicking -bool true                       # tap to click
  defaults write "$domain" TrackpadRightClick -bool true             # two-finger right click
  defaults write "$domain" FirstClickThreshold -int 1                # medium click firmness
  defaults write "$domain" TrackpadThreeFingerDrag -bool false
done
defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1  # tap to click on login screen too
defaults write NSGlobalDomain com.apple.trackpad.scaling -float 0.6875   # trackpad speed
defaults write NSGlobalDomain com.apple.mouse.scaling -float 0.875       # mouse speed
defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false # natural scrolling off

# --- Dock
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock autohide-delay -float 0      # appears instantly
defaults write com.apple.dock orientation -string left
defaults write com.apple.dock tilesize -int 34
defaults write com.apple.dock magnification -bool true
defaults write com.apple.dock show-recents -bool false     # only pinned apps
for corner in tl tr bl br; do                               # no hot corners
  defaults write com.apple.dock "wvous-$corner-corner" -int 1
  defaults write com.apple.dock "wvous-$corner-modifier" -int 0
done

# Pinned apps, in order. Apps that aren't installed are skipped.
dock_apps=(
  "/Applications/Google Chrome.app"
  "/Applications/Slack.app"
  "/System/Applications/Messages.app"
  "/Applications/Claude.app"
  "/Applications/Ghostty.app"
  "/System/Applications/Notes.app"
  "/System/Applications/Reminders.app"
  "/System/Applications/Photos.app"
  "/Applications/1Password.app"
  "/Applications/Spotify.app"
  "/Applications/Serato DJ Pro.app"
  "/System/Applications/iPhone Mirroring.app"
  "/System/Applications/System Settings.app"
)
if command -v dockutil >/dev/null; then
  dockutil --remove all --no-restart >/dev/null
  for app in "${dock_apps[@]}"; do
    if [[ -d "$app" ]]; then dockutil --add "$app" --no-restart >/dev/null; fi
  done
fi
killall Dock

# --- Finder
defaults write com.apple.finder FXPreferredViewStyle -string clmv         # column view
defaults write com.apple.finder _FXSortFoldersFirst -bool true
defaults write NSGlobalDomain AppleShowAllExtensions -bool true
defaults write com.apple.finder ShowPathbar -bool true
defaults write com.apple.finder ShowStatusBar -bool true
defaults write com.apple.finder FXDefaultSearchScope -string SCcf         # search the current folder
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool true # keep the warning
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
killall Finder

# --- Appearance, screenshots, sound
defaults delete NSGlobalDomain AppleInterfaceStyle 2>/dev/null || true   # light mode
defaults write NSGlobalDomain AppleInterfaceStyleSwitchesAutomatically -bool false
defaults write com.apple.screencapture location -string "$HOME/Desktop"
defaults write NSGlobalDomain com.apple.sound.beep.feedback -int 1        # play sound on volume change
# Startup chime: left on (the macOS default). Changing it needs admin (nvram), so it isn't scripted.

# --- Keyboard shortcuts
# hotkey <id> <ascii> <keycode> <modifiers>  (modifiers: 262144 Ctrl, 524288 Option, 1048576 Cmd)
hotkey() {
  defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add "$1" \
    "<dict><key>enabled</key><true/><key>value</key><dict><key>parameters</key><array><integer>$2</integer><integer>$3</integer><integer>$4</integer></array><key>type</key><string>standard</string></dict></dict>"
}
hotkey 64 65535 49 524288       # Spotlight: Option+Space (Cmd+Space is Alfred)
hotkey 65 65535 49 1572864      # Finder search window: Cmd+Option+Space
hotkey 79 65535 123 8650752     # Ctrl+Left: previous desktop
hotkey 81 65535 124 8650752     # Ctrl+Right: next desktop
desktop_keycodes=(18 19 20 21 23 22 26 28 25)   # keys 1-9
for n in 1 2 3 4 5 6 7 8 9; do
  hotkey $((117 + n)) 65535 "${desktop_keycodes[$((n - 1))]}" 262144   # Ctrl+n: desktop n
done
# Apply shortcut changes without logging out
/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u

# --- Alfred: settings sync through iCloud Drive
# Alfred 5 keeps its sync folder in prefs.json. Only switch once the iCloud copy exists,
# and quit Alfred first so it doesn't overwrite the file.
alfred_sync="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Alfred"
alfred_prefs="$HOME/Library/Application Support/Alfred/prefs.json"
if [[ -d "$alfred_sync/Alfred.alfredpreferences" ]] && ! grep -q "com~apple~CloudDocs/Alfred" "$alfred_prefs" 2>/dev/null; then
  osascript -e 'quit app "Alfred 5"' 2>/dev/null || true
  mkdir -p "$(dirname "$alfred_prefs")"
  cat > "$alfred_prefs" <<JSON
{
  "current" : "$alfred_sync/Alfred.alfredpreferences",
  "syncfolders" : {
    "5" : "~/Library/Mobile Documents/com~apple~CloudDocs/Alfred"
  }
}
JSON
  open -a "Alfred 5" 2>/dev/null || true
fi

echo "macOS settings applied. Some take effect after logging out and back in."
{{ end -}}
